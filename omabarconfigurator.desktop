[Desktop Entry]
Type=Application
Name=OmaBar Configurator
GenericName=Omarchy Bar Widgets
Comment=Show, hide and reorder the widgets on the Omarchy bar
Exec=omarchy-shell shell toggle io.github.felipecpaiva.omabarconfigurator
TryExec=omarchy-shell
Icon=preferences-desktop
Terminal=false
StartupNotify=false
Categories=Settings;DesktopSettings;
Keywords=omarchy;bar;widget;widgets;panel;statusbar;tray;clock;configure;
X-OmaBarConfigurator-Managed=true
